# Public URL of the site (used for canonical URLs, sitemap, share links)
NEXT_PUBLIC_SITE_URL=https://aptusgroup.net

# --- Admin auth ---------------------------------------------------------
# The ONLY phone number that can receive admin login codes (E.164, no spaces)
ADMIN_PHONE=+254700000000
# Long random string (32+ chars). Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- SMS provider -------------------------------------------------------
# One of: sozuri | africastalking | console   (console = dev only, prints code to server log)
SMS_PROVIDER=console
SMS_SENDER_ID=

# Sozuri
SOZURI_API_KEY=
SOZURI_PROJECT=
SOZURI_API_URL=https://sozuri.net/api/v1/messaging

# Africa's Talking
AT_USERNAME=
AT_API_KEY=

# --- Database (Upstash Redis via Vercel Marketplace) -----------------------
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# Either naming works. If neither is set, a local file store (.data/) is used in development.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
