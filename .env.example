# Public URL of the site (used for canonical URLs, sitemap, share links, receipts)
NEXT_PUBLIC_SITE_URL=https://aptusgroup.net

# --- Admin sign-in ------------------------------------------------------
# Password for the single admin account (min. 10 characters; use a long random one).
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Long random string (32+ chars) used to sign sessions and form challenges.
# Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional, for later: switch to SMS one-time codes instead of the password.
# AUTH_MODE=otp
# ADMIN_PHONE=+254700000000
# SMS_PROVIDER=sozuri          # sozuri | africastalking | console (dev only)
# SMS_SENDER_ID=
# SOZURI_API_KEY=
# SOZURI_PROJECT=
# SOZURI_API_URL=https://sozuri.net/api/v1/messaging
# AT_USERNAME=
# AT_API_KEY=

# --- Email (contact/quote notifications, "send receipt") -------------------
# Option A: SMTP, e.g. Gmail with an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B: Resend (resend.com) instead of SMTP
# RESEND_API_KEY=
# Sender and the inbox that receives website requests (defaults: SMTP_USER / company email)
# MAIL_FROM=Aptus Group <logisticsaptusgroup@gmail.com>
# MAIL_TO=logisticsaptusgroup@gmail.com
# In development without SMTP/Resend, emails are saved to .data/outbox/ instead.

# --- Database (Upstash Redis via Vercel Marketplace) -----------------------
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# If neither is set, a local file store (.data/) is used in development.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
